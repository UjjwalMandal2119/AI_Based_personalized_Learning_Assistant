# Local development values only. Replace the password and JWT secret before use.
DB_NAME=learning_assistant
DB_USERNAME=root
DB_PASSWORD=replace-with-a-local-password
DB_URL=jdbc:mysql://localhost:3306/learning_assistant
JWT_SECRET=replace-with-a-base64-encoded-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600
GEMINI_API_KEY=replace-with-your-Gemini-API-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONNECT_TIMEOUT=5s
GEMINI_RESPONSE_TIMEOUT=60s
# Ollama (primary AI provider — runs locally)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CONNECT_TIMEOUT=5s
OLLAMA_RESPONSE_TIMEOUT=60s
# Set to host.docker.internal when running Spring Boot inside Docker
# AI provider routing
AI_FALLBACK_ENABLED=true
AI_GEMINI_ENABLED=true
