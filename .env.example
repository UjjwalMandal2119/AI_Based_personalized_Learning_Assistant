# Local development values only. Replace the password and JWT secret before use.
DB_NAME=learning_assistant
DB_USERNAME=root
DB_PASSWORD=replace-with-a-local-password
DB_URL=jdbc:mysql://localhost:3306/learning_assistant
JWT_SECRET=replace-with-a-base64-encoded-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600
GEMINI_API_KEY=replace-with-your-Gemini-API-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONNECT_TIMEOUT=5s
GEMINI_RESPONSE_TIMEOUT=60s
